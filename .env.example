# Copy to .env for local use. In GitHub, add the same names as repository secrets
# (Settings > Secrets and variables > Actions).

# --- Send-to-PocketBook (e-mail) ---
# Your device address, shown in PocketBook Cloud / on the device under Send-to-PocketBook.
POCKETBOOK_EMAIL=yourname@pbsync.com
# Any SMTP account. Add SMTP_FROM to the allowed senders list in PocketBook Cloud first.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
# For Gmail/Outlook use an app password, not your normal password.
SMTP_PASSWORD=app-password
SMTP_FROM=you@gmail.com

# --- Zotero inbox (optional) ---
# https://www.zotero.org/settings/keys : "Your userID for use in API calls" and a new key
# with "Allow library access" + "Allow write access" (write is needed to re-tag sent items).
ZOTERO_USER_ID=1234567
ZOTERO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides (GitHub: repository *variables*, not secrets)
# ZOTERO_INBOX_TAG=to-pocketbook
# ZOTERO_DONE_TAG=sent-to-pocketbook
# ZOTERO_FAILED_TAG=pocketbook-failed
# ZOTERO_COLLECTION=ABCD1234   # use a collection as the inbox instead of a tag
# ZOTERO_GROUP_ID=123456       # use a group library instead of your personal one
